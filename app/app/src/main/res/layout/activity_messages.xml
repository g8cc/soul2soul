<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView
        android:id="@+id/btnBack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="34dp"
        android:background="?android:attr/selectableItemBackground"
        android:padding="12dp"
        android:text="@string/msg_back"
        android:textColor="@color/text_secondary"
        android:textSize="16sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="6dp"
        android:text="@string/msg_title"
        android:textColor="@color/text_primary"
        android:textSize="22sp"
        android:textStyle="bold" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMessages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingTop="6dp"
        android:paddingBottom="10dp" />

    <TextView
        android:id="@+id/tvEmpty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:padding="32dp"
        android:text="@string/msg_empty"
        android:textColor="@color/text_secondary"
        android:textSize="15sp"
        android:visibility="gone" />

    <!-- 表情面板：点 😊 弹出，微信/QQ 式多行网格（纵向滚动），点表情插到输入框光标处。
         单行横滑在 30+ 个表情下根本够不着，收起前还得左右挪。
         列数自适应而非写死 8：窄屏（360dp）上 8 列单元格仅约 41dp，容不下
         28sp 表情+左右 padding（约 48dp+），每个表情两侧都被裁（真机反馈）。 -->
    <GridView
        android:id="@+id/emojiPanel"
        android:layout_width="match_parent"
        android:layout_height="232dp"
        android:background="@color/white"
        android:numColumns="auto_fit"
        android:columnWidth="56dp"
        android:paddingHorizontal="6dp"
        android:paddingVertical="6dp"
        android:horizontalSpacing="2dp"
        android:verticalSpacing="2dp"
        android:stretchMode="spacingWidthUniform"
        android:scrollbars="vertical"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp">

        <ImageView
            android:id="@+id/btnEmoji"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/msg_emoji_toggle_desc"
            android:padding="8dp"
            android:src="@drawable/ic_emoji_toggle" />

        <ImageView
            android:id="@+id/btnMic"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/msg_voice_toggle_desc"
            android:padding="8dp"
            android:src="@drawable/ic_mic_toggle" />

        <EditText
            android:id="@+id/etInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_card"
            android:hint="@string/msg_hint"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="4"
            android:minHeight="48dp"
            android:padding="12dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnHoldTalk"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_card"
            android:gravity="center"
            android:text="@string/msg_hold_talk"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnSend"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_call"
            android:paddingHorizontal="16dp"
            android:text="@string/msg_send"
            android:textColor="@color/white"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>

    <!-- 录音浮层：微信式跳动音柱 + 秒数 + "松开发送·上滑取消" -->
    <LinearLayout
        android:id="@+id/recOverlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_bubble"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:minWidth="200dp"
        android:orientation="vertical"
        android:padding="20dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:gravity="center"
            android:orientation="horizontal">

            <View
                android:id="@+id/bar1"
                android:layout_width="5dp"
                android:layout_height="10dp"
                android:layout_marginEnd="5dp"
                android:background="@color/white" />

            <View
                android:id="@+id/bar2"
                android:layout_width="5dp"
                android:layout_height="20dp"
                android:layout_marginEnd="5dp"
                android:background="@color/white" />

            <View
                android:id="@+id/bar3"
                android:layout_width="5dp"
                android:layout_height="34dp"
                android:layout_marginEnd="5dp"
                android:background="@color/white" />

            <View
                android:id="@+id/bar4"
                android:layout_width="5dp"
                android:layout_height="20dp"
                android:layout_marginEnd="5dp"
                android:background="@color/white" />

            <View
                android:id="@+id/bar5"
                android:layout_width="5dp"
                android:layout_height="12dp"
                android:background="@color/white" />

            <TextView
                android:id="@+id/tvRecTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvRecHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="@string/msg_hold_release"
            android:textColor="@color/white"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvRecCancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="@string/msg_hold_slide_cancel"
            android:textColor="#E6E6E6"
            android:textSize="13sp" />
    </LinearLayout>

</FrameLayout>
