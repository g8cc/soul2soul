<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_call">

    <org.webrtc.SurfaceViewRenderer
        android:id="@+id/renderer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.soul2soul.app.session.DrawingOverlayView
        android:id="@+id/drawingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 特效本地回显层（View 默认不消费触摸，点击会穿透到下层画笔/操控层） -->
    <com.soul2soul.app.session.OverlayCanvasView
        android:id="@+id/fxLayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 表情互动的本地回显层 -->
    <FrameLayout
        android:id="@+id/emojiLayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/tvState"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="@string/connecting"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:visibility="gone" />

    <!-- 来电 -->
    <LinearLayout
        android:id="@+id/boxIncoming"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_call"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/incoming_call"
            android:textColor="@color/white"
            android:textSize="40sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvCountdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:textColor="#99FFFFFF"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/incoming_call_body"
            android:textColor="#CCFFFFFF"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="84dp"
                android:layout_height="84dp">

                <View
                    android:layout_width="84dp"
                    android:layout_height="84dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_accept" />

                <Button
                    android:id="@+id/btnAccept"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_accept"
                    android:text="@string/accept"
                    android:textColor="@color/white"
                    android:textSize="14sp" />
            </FrameLayout>

            <Space
                android:layout_width="64dp"
                android:layout_height="1dp" />

            <FrameLayout
                android:layout_width="84dp"
                android:layout_height="84dp">

                <View
                    android:layout_width="84dp"
                    android:layout_height="84dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_decline" />

                <Button
                    android:id="@+id/btnDecline"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_decline"
                    android:text="@string/decline"
                    android:textColor="@color/white"
                    android:textSize="14sp" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- 底部控制区：表情面板 + 工具条（轻点画面呼出/隐藏，5 秒自动收纳） -->
    <LinearLayout
        android:id="@+id/controlsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/emojiPanel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_bubble"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/emoji0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:text="❤️"
                android:textSize="28sp" />

            <TextView
                android:id="@+id/emoji1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:text="😂"
                android:textSize="28sp" />

            <TextView
                android:id="@+id/emoji2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:text="👍"
                android:textSize="28sp" />

            <TextView
                android:id="@+id/emoji3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:text="😮"
                android:textSize="28sp" />

            <TextView
                android:id="@+id/emoji4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:text="🥺"
                android:textSize="28sp" />

            <TextView
                android:id="@+id/emoji5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:text="🔥"
                android:textSize="28sp" />
        </LinearLayout>

        <!-- 第二行：满屏特效（微信群礼物式玩法） -->
        <LinearLayout
            android:id="@+id/fxRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_bubble"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/fxBomb"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:text="💥"
                android:textSize="28sp" />

            <TextView
                android:id="@+id/fxGift"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:text="🎁"
                android:textSize="28sp" />

            <TextView
                android:id="@+id/fxRocket"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:text="🚀"
                android:textSize="28sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/boxLive"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:background="@drawable/bg_bubble"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp">

            <Button
                android:id="@+id/btnColor0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:paddingHorizontal="12dp"
                android:text="@string/color_red"
                android:textColor="@color/primary"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnColor1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:minWidth="0dp"
                android:paddingHorizontal="12dp"
                android:text="@string/color_green"
                android:textColor="@color/green"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnColor2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:minWidth="0dp"
                android:paddingHorizontal="12dp"
                android:text="@string/color_blue"
                android:textColor="@color/blue"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnClear"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:minWidth="0dp"
                android:paddingHorizontal="12dp"
                android:text="@string/clear_strokes"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnHd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:minWidth="0dp"
                android:paddingHorizontal="12dp"
                android:text="@string/hd_on"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnEmoji"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:minWidth="0dp"
                android:paddingHorizontal="12dp"
                android:text="@string/emoji_toggle"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnCtl"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:minWidth="0dp"
                android:paddingHorizontal="10dp"
                android:text="@string/ctl_off"
                android:textSize="12sp" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvRtt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:textColor="@color/green"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvElapsed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:textColor="@color/white"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnHangup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/primary"
                android:minWidth="0dp"
                android:paddingHorizontal="16dp"
                android:text="@string/action_end"
                android:textColor="@color/white" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
