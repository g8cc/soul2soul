<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- 观看端 letterbox 空隙用纯黑衬底（影院黑边语义，一眼懂"这是边不是内容"）。
         曾用远端画面模糊放大做衬底，但糊图=前景内容的鬼影，两台手机比例不同时
         看起来像两块屏幕重叠，观感更差，已回退为纯黑 -->

    <!-- MIUI 合成层会对视频 SurfaceView 做"铺满拉伸"，无视 GL letterbox → 底部被裁。
         SessionActivity 在收到远端视频尺寸后把本 View 缩成视频等比尺寸并居中，
         视图比例=内容比例，任何 ROM 合成都裁不掉内容 -->
    <org.webrtc.SurfaceViewRenderer
        android:id="@+id/renderer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.soul2soul.app.session.DrawingOverlayView
        android:id="@+id/drawingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 特效本地回显层（View 默认不消费触摸，点击会穿透到下层画笔/操控层） -->
    <com.soul2soul.app.session.OverlayCanvasView
        android:id="@+id/fxLayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 表情互动的本地回显层 -->
    <FrameLayout
        android:id="@+id/emojiLayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 操控模式横幅：MIUI 会吞 toast，模式状态必须持久可见。
         挂在根 FrameLayout 顶部而非底部菜单内——操控时整套菜单收起，横幅要留下来 -->
    <TextView
        android:id="@+id/tvCtlMode"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal|top"
        android:layout_marginTop="32dp"
        android:background="@drawable/bg_chip_active"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:text="@string/ctl_banner"
        android:textColor="@color/white"
        android:textSize="12sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvState"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="@string/connecting"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:visibility="gone" />

    <!-- 来电 -->
    <LinearLayout
        android:id="@+id/boxIncoming"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_call"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/incoming_call"
            android:textColor="@color/white"
            android:textSize="40sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvCountdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:textColor="#99FFFFFF"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/incoming_call_body"
            android:textColor="#CCFFFFFF"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="84dp"
                android:layout_height="84dp">

                <View
                    android:layout_width="84dp"
                    android:layout_height="84dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_accept" />

                <Button
                    android:id="@+id/btnAccept"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_accept"
                    android:text="@string/accept"
                    android:textColor="@color/white"
                    android:textSize="14sp" />
            </FrameLayout>

            <Space
                android:layout_width="64dp"
                android:layout_height="1dp" />

            <FrameLayout
                android:layout_width="84dp"
                android:layout_height="84dp">

                <View
                    android:layout_width="84dp"
                    android:layout_height="84dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_decline" />

                <Button
                    android:id="@+id/btnDecline"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_decline"
                    android:text="@string/decline"
                    android:textColor="@color/white"
                    android:textSize="14sp" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- 底部控制区：表情面板 + 工具条（轻点画面呼出/隐藏，5 秒自动收纳） -->
    <LinearLayout
        android:id="@+id/controlsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/emojiPanel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_bubble"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/emoji0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:text="❤️"
                android:textSize="28sp" />

            <TextView
                android:id="@+id/emoji1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:text="😂"
                android:textSize="28sp" />

            <TextView
                android:id="@+id/emoji2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:text="👍"
                android:textSize="28sp" />

            <TextView
                android:id="@+id/emoji3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:text="😮"
                android:textSize="28sp" />

            <TextView
                android:id="@+id/emoji4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:text="🥺"
                android:textSize="28sp" />

            <TextView
                android:id="@+id/emoji5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:text="🔥"
                android:textSize="28sp" />
        </LinearLayout>

        <!-- 第二行：满屏特效（微信群礼物式玩法） -->
        <LinearLayout
            android:id="@+id/fxRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_bubble"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/fxBomb"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:text="💥"
                android:textSize="28sp" />

            <TextView
                android:id="@+id/fxGift"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:text="🎁"
                android:textSize="28sp" />

            <TextView
                android:id="@+id/fxRocket"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:text="🚀"
                android:textSize="28sp" />
        </LinearLayout>

        <!-- 第一行：画笔工具（小色点+短标签，Mi5 小屏也放得下） -->
        <LinearLayout
            android:id="@+id/boxLive"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="6dp"
            android:background="@drawable/bg_bubble"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp">

            <View
                android:id="@+id/btnColor0"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_dot"
                android:backgroundTint="@color/primary" />

            <View
                android:id="@+id/btnColor1"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_dot"
                android:backgroundTint="@color/green" />

            <View
                android:id="@+id/btnColor2"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_dot"
                android:backgroundTint="@color/blue" />

            <TextView
                android:id="@+id/btnClear"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_chip"
                android:paddingHorizontal="10dp"
                android:paddingVertical="6dp"
                android:text="@string/clear_strokes"
                android:textColor="@color/white"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/btnHd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_chip"
                android:paddingHorizontal="10dp"
                android:paddingVertical="6dp"
                android:text="@string/hd_on"
                android:textColor="@color/white"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/btnEmoji"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_chip"
                android:paddingHorizontal="10dp"
                android:paddingVertical="6dp"
                android:text="@string/emoji_toggle"
                android:textColor="@color/white"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/btnCtl"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_chip"
                android:paddingHorizontal="10dp"
                android:paddingVertical="6dp"
                android:text="@string/ctl_off"
                android:textColor="@color/white"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 第二行：通话状态 + 挂断 -->
        <LinearLayout
            android:id="@+id/boxStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_bubble"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp">

            <TextView
                android:id="@+id/tvElapsed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvRtt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:textColor="@color/green"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvMic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_chip"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:text="@string/mic_on"
                android:textColor="@color/white"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/btnHangup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:background="@drawable/bg_chip"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="@string/action_end"
                android:textColor="@color/primary"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
