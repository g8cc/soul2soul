<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Soul2Soul" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:statusBarColor">@color/primary</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- 留言表情面板里的单个表情：单元格宽 56dp（auto_fit 保证不裁），文字必须居中 -->
    <style name="MsgEmoji">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:padding">10dp</item>
        <item name="android:textSize">28sp</item>
        <item name="android:gravity">center</item>
        <item name="android:background">?android:attr/selectableItemBackgroundBorderless</item>
    </style>

    <!-- 表情面板分组 tab：选中态由代码换 bg_chip_active/primary 文字色 -->
    <style name="MsgEmojiTab">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginEnd">10dp</item>
        <item name="android:paddingHorizontal">14dp</item>
        <item name="android:paddingVertical">6dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:background">@drawable/bg_chip</item>
    </style>
</resources>
